gamedata/configs/text/pol/*.xml text eol=crlf encoding=cp1250
gamedata/configs/text/rus/*.xml text eol=crlf encoding=cp1251
gamedata/configs/text/spa/*.xml text eol=crlf encoding=cp1252

# X-Ray scripts
*.script linguist-detectable
*.s      linguist-detectable
*.s_     linguist-detectable
*.script text eol=crlf encoding=utf-8 linguist-language=Lua gitlab-language=lua
*.s      text eol=crlf encoding=utf-8 linguist-language=Lua gitlab-language=lua
*.s_     text eol=crlf encoding=utf-8 linguist-language=Lua gitlab-language=lua
*.lua    text eol=crlf encoding=utf-8

