# Global attributes for forcing line endings normalization of specific files

* text=auto

# Git configs
*.gitattributes text eol=lf encoding=utf-8
*.gitignore     text eol=lf encoding=utf-8

# Markdown documents
*.md text eol=crlf encoding=utf-8

# YAML-based files
*.yml  text eol=lf encoding=utf-8
*.yaml text eol=lf encoding=utf-8

# JSON-based files
*.json           text eol=crlf encoding=utf-8
*.code-workspace text eol=crlf encoding=utf-8

# XML-based files
*.manifest text eol=crlf encoding=utf-8
*.config   text eol=crlf encoding=utf-8

# INI-based files
*.ini          text eol=crlf encoding=utf-8
*.INI          text eol=crlf encoding=utf-8
*.editorconfig text eol=crlf encoding=utf-8

# CMake files
CMakeLists.txt text eol=lf encoding=utf-8
*.cmake        text eol=lf encoding=utf-8

# Windows binaries
*.exe binary
*.dll binary
*.bpl binary
*.bpi binary
*.pdb binary
*.tds binary

# Batch scripts
*.bat text eol=crlf encoding=utf-8
*.cmd text eol=crlf encoding=utf-8

# PowerShell scripts
*.ps1 text eol=crlf encoding=utf-8

# Python scripts
*.py text eol=crlf encoding=utf-8

# X-Ray configs
*.ltx linguist-detectable
*.seq linguist-detectable
*.ltx text eol=crlf encoding=cp1251 linguist-language=INI gitlab-language=ini
*.seq text eol=crlf encoding=cp1251 linguist-language=INI gitlab-language=ini
gamedata/configs/gameplay/*.xml text eol=crlf encoding=cp1251
gamedata/configs/ui/*.xml       text eol=crlf encoding=cp1251
gamedata/configs/text/cze/*.xml text eol=crlf encoding=cp1250
gamedata/configs/text/eng/*.xml text eol=crlf encoding=cp1252
gamedata/configs/text/fra/*.xml text eol=crlf encoding=cp1252
gamedata/configs/text/ger/*.xml text eol=crlf encoding=cp1252
